def test_project_aliases_resolve_to_stable_identity(registry: Path) -> None:
    cloud = {resolve_project_alias(value, registry_path=registry).project_id for value in (
        "cloud-test", "cloud test", "petlibro cloud test", "接口自动化", "接口自动化功能开发",
    )}
    load = {resolve_project_alias(value, registry_path=registry).project_id for value in (
        "load-testing", "load test", "压测", "压测平台",
    )}
    travel = {resolve_project_alias(value, registry_path=registry).project_id for value in (
        "codex_travel", "travel", "旅游", "旅游 mainline",
    )}
    assert cloud == {"petlibro-cloud-test-platform"}
    assert load == {"petlibro-load-testing"}
    assert travel == {"codex_travel"}


def test_legacy_project_identity_is_registered_without_config_writes(registry: Path) -> None:
    """The old repo DesignLibro/petlibro_cloud_test resolves to its own registered identity, not the
    platform project that owns the `cloud-test` alias, and nothing writes machine config."""
    import gateway.semantic_control as sc

    before = registry.read_bytes()
    legacy = sc.resolve_project_alias("petlibro_cloud_test 上一轮开发", registry_path=registry)
    assert legacy is not None
    assert (legacy.project_id, legacy.repository) == (
        "petlibro-cloud-test-legacy",
        "DesignLibro/petlibro_cloud_test",
    )
    assert legacy == sc._LEGACY_PROJECT_IDENTITIES[0]
    platform = sc.resolve_project_alias("cloud-test 当前状态", registry_path=registry)
    assert platform is not None and platform.project_id == "petlibro-cloud-test-platform"
    assert registry.read_bytes() == before


def test_legacy_identity_does_not_hijack_the_platform_projects_own_name(registry: Path) -> None:
    """Naming the platform project must return the platform project.

    The legacy alias ``petlibro-cloud-test`` also occurs inside the registered platform project's own
    repository name ``petlibro-cloud-test-platform``. Alias matching is substring-based, so resolving
    by iteration order made whichever record came first win: naming the platform returned the legacy
    project. Resolution is now by longest alias, which is a property of the text, not of the registry.
    """
    sc = resolve_project_alias
    for value in (
        "petlibro-cloud-test-platform",
        "petlibro-cloud-test-platform 的情况怎么样",
        "DesignLibro/petlibro-cloud-test-platform 状态",
        "petlibro-cloud-test-platform 的进展",
    ):
        resolved = sc(value, registry_path=registry)
        assert resolved is not None, value
        assert resolved.project_id == "petlibro-cloud-test-platform", value
    # …while the old repo's own names still resolve to the legacy identity.
    for value in (
        "petlibro_cloud_test",
        "petlibro_cloud_test 上一轮开发现在是什么状态",
        "DesignLibro/petlibro_cloud_test 状态",
        "petlibro-cloud-test-legacy",
    ):
        resolved = sc(value, registry_path=registry)
        assert resolved is not None, value
        assert resolved.project_id == "petlibro-cloud-test-legacy", value


