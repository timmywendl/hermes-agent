def test_create_native_remote_task_propagates_subscription_failure(tmp_path, monkeypatch):
    from gateway.remote_work import create_native_remote_task
    from hermes_cli import kanban_db as kb
    from hermes_cli import kanban_db_connect as kbc
    from hermes_cli import kanban_db_notify as kbn

    home = tmp_path / ".hermes"
    home.mkdir()
    monkeypatch.setenv("HERMES_HOME", str(home))
    monkeypatch.setenv("HERMES_KANBAN_DB", str(home / "kanban.db"))
    monkeypatch.setattr(Path, "home", lambda: tmp_path)
    kb.init_db()
    kbc.init_db()
    monkeypatch.setattr(kbn, "add_notify_sub", lambda *args, **kwargs: (_ for _ in ()).throw(RuntimeError("db locked")))

    source = SessionSource(platform=Platform.TELEGRAM, chat_id="chat-42", chat_type="dm")
    try:
        create_native_remote_task(
            source=source,
            packet="bounded packet",
            objective="continue fixture",
            session_id="control-session",
            idempotency_key="telegram-remote-work-v2:sub-failure",
            delivery_metadata={},
        )
    except RuntimeError as exc:
        assert str(exc) == "db locked"
    else:
        raise AssertionError("subscription failure was swallowed")
