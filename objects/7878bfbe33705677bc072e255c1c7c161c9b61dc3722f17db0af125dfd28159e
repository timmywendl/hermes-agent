"""Offline regression tests for the Hermes Dashboard host bundle build.

These tests never sign, install, register, or execute anything against the live system: they cover
the plist contract (which is the part launchd and SMAppService actually read), the argv validation
grammar, and the build report. The signing path is exercised separately by the build script at the
Human gate because it needs the operator's identity in the keychain.
"""

from __future__ import annotations

import importlib.util
import plistlib
import subprocess
import sys
from pathlib import Path

import pytest

MODULE_PATH = Path(__file__).resolve().parents[2] / "macos" / "dashboard-host" / "build_host.py"
SOURCE_DIR = MODULE_PATH.parent / "Sources" / "HermesDashboardHost"
_spec = importlib.util.spec_from_file_location("build_host", MODULE_PATH)
assert _spec and _spec.loader
build_host = importlib.util.module_from_spec(_spec)
sys.modules["build_host"] = build_host
_spec.loader.exec_module(build_host)

HOST_EXECUTABLE = "<HOME>/.hermes/cache/scratch/host-build-20261016/HermesDashboardHost.app/Contents/MacOS/hermes-dashboard-host"


def make_configuration(**overrides) -> build_host.AgentConfiguration:
    values = {
        "child_executable": "<HOME>/.hermes/hermes-agent/venv/bin/hermes",
        "child_arguments": ("dashboard", "--port", "9119", "--host", "127.0.0.1", "--no-open"),
        "stdout_path": "<HOME>/.hermes/logs/dashboard.log",
        "stderr_path": "<HOME>/.hermes/logs/dashboard.error.log",
        "working_directory": "<HOME>",
        "environment": {
            "PATH": "/usr/bin:/bin",
            "VIRTUAL_ENV": "<HOME>/.hermes/hermes-agent/venv",
            "HERMES_HOME": "<HOME>/.hermes",
        },
    }
    values.update(overrides)
    return build_host.AgentConfiguration(**values)


class TestAgentPlistContract:
    """The plist is what launchd reads; every field here is load-bearing for TCC attribution."""

    def parsed(self, configuration=None) -> dict:
        return plistlib.loads(build_host.render_agent_plist(configuration or make_configuration()))

    def test_uses_bundle_program_so_launchd_runs_the_signed_app(self):
        document = self.parsed()
        assert document["BundleProgram"] == "Contents/MacOS/hermes-dashboard-host"
        # BundleProgram is app-bundle-relative and SMAppService-only; an absolute path would not
        # survive the app being relocated and would bypass the bundle identity.
        assert not document["BundleProgram"].startswith("/")

    def test_label_is_stable_and_matches_the_dashboard_job(self):
        assert self.parsed()["Label"] == build_host.AGENT_LABEL

    def test_launchd_arguments_route_through_child_exec_mode(self):
        document = self.parsed()
        argv = document["BundleProgramArguments"]
        assert argv[:2] == ["--child-exec", "--"]
        assert argv[2] == "<HOME>/.hermes/hermes-agent/venv/bin/hermes"
        assert argv[3:] == ["dashboard", "--port", "9119", "--host", "127.0.0.1", "--no-open"]

    def test_preserves_dashboard_log_destinations(self):
        document = self.parsed()
        assert document["StandardOutPath"] == "<HOME>/.hermes/logs/dashboard.log"
        assert document["StandardErrorPath"] == "<HOME>/.hermes/logs/dashboard.error.log"

    def test_carries_environment_needed_by_the_dashboard(self):
        environment = self.parsed()["EnvironmentVariables"]
        assert environment["VIRTUAL_ENV"].endswith("hermes-agent/venv")
        assert environment["HERMES_HOME"].endswith(".hermes")
        assert environment["HERMES_SUPERVISED_CHILD"] == "1"

    def test_keeps_restart_semantics_of_a_supervised_service(self):
        document = self.parsed()
        assert document["RunAtLoad"] is True
        # SuccessfulExit=false parks a clean stop instead of respawning forever.
        assert document["KeepAlive"] == {"SuccessfulExit": False}
        assert document["ThrottleInterval"] == 30
        assert document["ExitTimeOut"] == 60

    def test_does_not_declare_conflicting_program_keys(self):
        document = self.parsed()
        # ProgramArguments/Program alongside BundleProgram would let launchd run an unbundled
        # executable, which is exactly the identity the host exists to replace.
        assert "Program" not in document
        assert "ProgramArguments" not in document
        assert "EnableGlobbing" not in document

    def test_rejects_an_empty_child_command(self):
        with pytest.raises(build_host.BundleBuildError):
            build_host.render_agent_plist(make_configuration(child_executable=""))

    def test_has_no_hardcoded_user_paths_in_the_template(self):
        """A source plist with placeholders must never ship a real username."""
        source = MODULE_PATH.parent / "Resources" / "ai.hermes.dashboard.host.plist"
        text = source.read_text(encoding="utf-8")
        assert "timmywen" not in text
        assert "__HERMES_DASHBOARD_CHILD_EXECUTABLE__" in text


