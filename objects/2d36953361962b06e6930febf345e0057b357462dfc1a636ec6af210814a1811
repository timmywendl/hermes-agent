    n.d = {
        "sub": {"task_id": "t_0123abcd", "platform": "telegram", "chat_id": "c",
                "delivery_mode": "notify+wake", "last_ping_event_id": 10},
        "task": _Task(), "board": "b", "events": [ev], "run_summaries": {10: SUMMARY},
    }
    n.runner = None
    n.platform_cls = None
    n.sub_fail_counts = {}
    n.sub = n.d["sub"]
    n.task = _Task()
    n.board_slug = "b"
    n.platform_str = "telegram"
    n.task_id = "t_0123abcd"
    n.sub_profile = ""
    n.title = "t"
    n.board_tag = "[b] "
    n.head = "h"
    n.sub_key = ("t_0123abcd", "telegram", "c", "")
    n.wake_agent = True
    n.send_passive = True
    n.wake_handoff = n.wake_review_detail = n.session_key = n.synth = ""
    n.pinged_event_ids = set()
    n.plat = n.adapter = None
    n.is_push_adapter = True
    n.wake_kinds = set()
    n.wake_diagnostic = False  # mirrors __init__
    return n


def test_suppression_requires_every_event_in_the_batch_to_be_confirmable():
    """Mixed batches keep the wake: one unconvertible event re-opens delivery."""
    from gateway.kanban_watchers_notifier import _KanbanNotification

    class _Task:
        title = "t"
        assignee = "worker"
        session_id = "s"

    def _note(events, checkpoint, pinged=()):
        n = _KanbanNotification.__new__(_KanbanNotification)
        n.runner = None
        n.d = {
            "sub": {"task_id": "t_0123abcd", "platform": "telegram", "chat_id": "c",
                    "delivery_mode": "notify+wake", "last_ping_event_id": checkpoint},
            "task": _Task(), "board": "b", "events": events, "run_summaries": {},
        }
        n.platform_cls = None
        n.sub_fail_counts = {}
        n.sub = n.d["sub"]
        n.task = _Task()
        n.board_slug = "b"
        n.platform_str = "telegram"
        n.task_id = "t_0123abcd"
        n.sub_profile = ""
        n.title = "t"
        n.board_tag = "[b] "
        n.head = "[b] @worker Kanban t_0123abcd"
        n.sub_key = ("t_0123abcd", "telegram", "c", "")
        n.wake_agent = True
        n.send_passive = True
        n.wake_handoff = n.wake_review_detail = n.session_key = n.synth = ""
        n.pinged_event_ids = set(pinged)
        n.plat = n.adapter = None
        n.is_push_adapter = True
        n.wake_kinds = set()
        return n

    class _Ev:
        def __init__(self, ident, kind):
            self.id = ident
            self.kind = kind
            self.payload = {"reason": "r", "summary": SUMMARY}
            self.run_id = 1

    def _note_with(events, checkpoint, pinged=()):
        note = _note(events, checkpoint, pinged=pinged)
        # The completed projection reads the exact run's summary from the claim dict, never the
        # event payload.
        note.d["run_summaries"] = {ev.id: SUMMARY for ev in events}
        return note

    completed = _Ev(10, "completed")
    n = _note_with([completed], checkpoint=10)
    assert n._passive_notification_already_delivered() is True

    # A completion whose ping THIS tick sent and checkpointed is the fresh-claim evidence.
    fresh = _note_with([completed], checkpoint=0, pinged={10})
    assert fresh._passive_notification_already_delivered() is True

    # completed is confirmed, but a sibling blocked event in the same batch is not.
    mixed = _note_with([completed, _Ev(11, "blocked")], checkpoint=11, pinged={10})
    assert mixed._passive_notification_already_delivered() is False

    # Checkpoint behind the event AND no ping recorded by this tick: delivery is UNKNOWN.
    behind = _note_with([completed], checkpoint=9)
    assert behind._passive_notification_already_delivered() is False

    # A completion whose summary cannot be projected is not a sufficient notification.
    unprojectable = _note_with([_Ev(12, "completed")], checkpoint=12, pinged={12})
    unprojectable.d["run_summaries"] = {12: "free text with no declared fields"}
    assert unprojectable._passive_notification_already_delivered() is True  # a delivered ping stands
