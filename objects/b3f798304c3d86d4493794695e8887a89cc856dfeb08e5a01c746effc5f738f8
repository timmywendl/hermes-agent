def test_all_emitted_text_values_are_consumer_valid(tmp_path):
    """Every text value we emit must be acceptable to the real allowlist."""
    from gateway.kanban_watchers_notifier import _safe_completion_value
    from hermes_cli import kanban_db as kb

    cases = [
        "SUMMARY=local tests passed\nNEXT_STEP=done",
        "SUMMARY=" + ("local tests passed " * 40) + "\nNEXT_STEP=done\nKANBAN_STATUS=PASS",
        "SUMMARY=" + ("安全 " * 200) + "\nNEXT_STEP=done",
        "SUMMARY=" + ("x" * 900) + "\nNEXT_STEP=" + ("y" * 900),
    ]
    for case in cases:
        out = kb._completion_event_summary(case, 400)
        assert len(out) <= 400
        for line in out.splitlines():
            if "=" not in line:
                continue
            key, _, value = line.partition("=")
            if key.strip().upper() in ("SUMMARY", "NEXT_STEP", "BLOCKERS"):
                assert value == "" or _safe_completion_value(value) is not None, (
                    f"invalid text value emitted for {key} in case {case[:40]!r}"
                )
