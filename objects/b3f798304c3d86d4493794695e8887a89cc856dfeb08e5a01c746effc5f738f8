def test_real_run_summary_survives_event_serialization(tmp_path):
    """Run-17's unsafe prose is withheld without emitting an empty required field.

    The original bug kept the unusable first-line SUMMARY and dropped NEXT_STEP.
    The fixed serializer fails closed for this non-contract-compliant value:
    it emits no partial contract that would deterministically render as
    RESULT_UNAVAILABLE. The contract-compliant path is covered below.
    """
    conn = _open(tmp_path)
    task_id = _create_and_complete(conn, summary=REAL_RUN_SUMMARY)
    _payload, event_summary = _completed_event_summary(conn, task_id)
    assert event_summary is None
    assert _completed_summary_lines(event_summary) == []


def test_event_summary_round_trips_through_real_notifier(tmp_path):
    """A projectable contract must still project after the event round-trip."""
    conn = _open(tmp_path)
    task_id = _create_and_complete(conn, summary=PROJECTABLE_SUMMARY)
    _payload, event_summary = _completed_event_summary(conn, task_id)

    assert event_summary is not None
    lines = _completed_summary_lines(event_summary)
    assert lines, "projectable contract produced empty projection after round-trip"
    assert any("NEXT_STEP" in ln or "done" in ln for ln in lines)


