+/* Q1 finite feasibility: complete explicit process-owned VM teardown. */
+static void hermes_hvf_process_exit(Notifier *notifier, void *opaque)
+{
+    CPUState *cpu;
+    unsigned int joined = 0;
+    (void)notifier;
+    (void)opaque;
+    CPU_FOREACH(cpu) {
+        if (cpu->created) {
+            cpu_remove_sync(cpu);
+            joined++;
+        }
+    }
+    memory_listener_unregister(&hvf_memory_listener);
+    hv_return_t result = hv_vm_destroy();
+    fprintf(stderr, "HERMES_HVF_VM_DESTROY_V1 pid=%d result=%d joined=%u\n",
+            getpid(), result, joined);
+    fflush(stderr);
+    if (result != HV_SUCCESS) {
+        _Exit(EXIT_FAILURE);
+    }
+}
+
+static Notifier hermes_hvf_exit_notifier = { .notify = hermes_hvf_process_exit };
+
