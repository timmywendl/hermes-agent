def test_ref_matches_the_natural_head_sha_shapes(kanban_home: Path) -> None:
    """Regression (R2 MAJOR): ``-``/``_`` must not block a ref match, or the
    advertised "head SHA" binding strands the card on a normal verdict."""
    cases = [
        ("9dfce6a", "VERDICT=APPROVE head-9dfce6a"),              # dash prefix
        ("9dfce6a", "reviewed 9dfce6a — approve"),                # bare
        ("PR-7", "APPROVE PR-7"),                                 # exact
        ("9dfce6ab", "approved 9dfce6ab"),                        # longer sha
    ]
    for ref, body in cases:
        with kbc.connect() as conn:
            tid = kb.create_task(conn, title=f"ref {ref}")
            kb.claim_task(conn, tid)
            assert _block_for_decision(conn, tid, kind="commented", ref=ref)
            kb.add_comment(conn, tid, author="main-control", body=body)
            assert _row(conn, tid)["status"] == "ready", f"{ref!r} should match {body!r}"

    # Extension must NOT match: PR-7 is not decided by PR-70.
    with kbc.connect() as conn:
        tid = kb.create_task(conn, title="no extension")
        kb.claim_task(conn, tid)
        assert _block_for_decision(conn, tid, kind="commented", ref="PR-7")
        kb.add_comment(conn, tid, author="main-control", body="APPROVE PR-70")
        assert _row(conn, tid)["status"] == "blocked"


def test_classify_in_place_carries_an_existing_wait_forward(kanban_home: Path) -> None:
    """Regression (R2 MAJOR): classifying a card that ALREADY waits on a bound
    decision must not strand it by replacing the newest blocked event."""
    from hermes_cli import kanban_db as _kb

    with kbc.connect() as conn:
        tid = kb.create_task(conn, title="already waiting", assignee="worker")
        kb.claim_task(conn, tid)
        # A kind-less worker block stores block_kind=NULL, indistinguishable
        # from a breaker-parked card to the operator path.
        assert kb.block_task(conn, tid, reason="wait", bound_decision={"kind": "commented"})
        with _kb.write_txn(conn):
            conn.execute("UPDATE tasks SET current_run_id = NULL WHERE id = ?", (tid,))
        assert kb.block_task(conn, tid, kind="needs_input") is True
        pending = kb.pending_bound_decision(conn, tid)
        assert pending is not None and pending["kind"] == "commented", (
            "classifying in place must carry the pending wait forward"
        )


def test_dispatch_tick_resumes_a_decision_written_inside_a_nested_txn(
    kanban_home: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """The dispatcher's sweep is the backstop for a nested composer; without it
    the card would strand (reviewer MINOR: the hookup was untested)."""
    import hermes_cli.config as cfgmod
    import hermes_cli.profiles as profmod
    from hermes_cli import kanban_db as _kb

    monkeypatch.setattr(profmod, "profile_exists", lambda _n: True)
    monkeypatch.setattr(cfgmod, "load_config", lambda *a, **k: {"kanban": {}})

    with kbc.connect() as conn:
        tid = kb.create_task(conn, title="nested decision", assignee="worker")
        kb.claim_task(conn, tid)
        assert _block_for_decision(conn, tid, kind="commented")
        with _kb.write_txn(conn, allow_nested=True):
            kb.add_comment(conn, tid, author="main-control", body="APPROVE")
        assert _row(conn, tid)["status"] == "blocked"

        kbd.dispatch_once(conn, spawn_fn=lambda t, w: None, dry_run=True)
        assert _row(conn, tid)["status"] in ("ready", "running")


def test_with_reason_returns_a_consistent_tuple(kanban_home: Path) -> None:
    """Regression (R2 MINOR): every with_reason outcome is a 2-tuple, so a
    refusal is never truthy."""
    with kbc.connect() as conn:
        tid = kb.create_task(conn, title="tuple shape")
        kb.claim_task(conn, tid)
        ok, why = kb.block_task(conn, tid, reason="wait", with_reason=True)
