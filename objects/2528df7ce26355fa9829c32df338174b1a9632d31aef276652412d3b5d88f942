def test_work_goal_words_are_not_question_tails():
    """通过/成功/失败 are normally the GOAL of the work, not a question marker. Only a genuine question
    form ("测试通过了吗", "是否通过", "通过的情况如何") makes the message a status query."""
    for text in (
        "请继续开发并确保测试通过",
        "请继续开发并让 CI 成功",
        "请继续开发并处理失败",
        "请继续开发并测试，确保成功",
        "请继续推进 cloud-test 直到通过",
        "请继续开发并让所有测试成功",
        "请继续开发并测试到通过",
        "帮我实现这个功能并让测试通过",
    ):
        assert classify_long_work_request(text) is True, text

    for text in (
        "之前的测试通过了吗",
        "之前测试成功了吗",
        "上次的构建失败了吗",
        "测试通过的情况如何",
        "这次测试是否通过",
    ):
        assert classify_long_work_request(text) is False, text


def test_finish_this_work_phrasings_are_still_detached():
    """Regression for a regex that lost its ``{0,N}`` quantifiers to f-string interpolation: the whole
    ``把…做完/完成/实现/修复`` family silently stopped being classified as work."""
    for text in (
        "把这个 Task 做完",
        "把这个功能实现",
        "把这个任务完成",
        "把这个 PR 完成",
        "把这个改动修复",
        "请把这个功能实现",
        "请把这个任务做完",
        "麻烦把这个功能补上",
    ):
        assert classify_long_work_request(text) is True, text


def test_work_regex_has_no_literalized_quantifiers():
    """Guard the class of bug directly: an rf-string containing ``{0,24}`` compiles to the literal text
    ``.(0, 24)`` instead of a quantifier, silently disabling a whole alternation branch."""
    import re as _re

    from gateway.remote_work import _LONG_WORK_RE

    assert _re.search(r"\.\(\d+,\s*\d+\)", _LONG_WORK_RE.pattern) is None


def test_explicit_review_and_development_requests_remain_detached():
    assert classify_long_work_request("请 Review这个PR并修复") is True
    assert classify_long_work_request("继续开发并测试") is True
    assert classify_long_work_request("当前状态如何？请继续开发并测试") is True
    assert classify_long_work_request("这个 PR 的 Review 结果是什么？") is False


def test_leading_prohibition_does_not_veto_work_in_a_later_clause():
    """``不要执行新任务`` vetoes the bare repeat it governs, not a work request stated after it.
    Only a negation that leaves no work language behind suppresses the message."""
    for text in (
        "不要执行新任务，继续开发 cloud-test",
        "不要新建任务，继续开发并测试",
        "不要执行新任务。请继续开发并测试",
        "不要提交代码，继续开发并测试",
        "不要执行新任务，帮我实现这个功能",
    ):
        assert classify_long_work_request(text) is True, text


def test_bounded_packet_has_authority_and_no_transcript_dependency():
    packet = build_bounded_execution_packet(
        "继续推进 ai-colleague 的安全本地 fixture",
        task_id="bg_test_123",
        project="spareribes/ai-colleague",
        authority="GitHub Issue #82",
    )

    assert "PROJECT: spareribes/ai-colleague" in packet
    assert "OBJECTIVE: 继续推进 ai-colleague 的安全本地 fixture" in packet
    assert "TASK: bg_test_123" in packet
    assert "AUTHORITY: GitHub Issue #82" in packet
    assert "Do not copy or depend on the Telegram transcript" in packet
    assert "Do not expose filesystem paths" in packet
    assert "reference-only local fixture" in packet
    assert "do not commit, push, open a PR, merge" in packet
    assert len(packet) <= 2400


