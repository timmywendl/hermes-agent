"""Bounded control-chat routing for long work.

The gateway already owns a native Kanban dispatcher. This module only decides
which ordinary Telegram messages should use it and builds the small packet given to
the fresh worker; it never copies the control-session transcript.
"""

from __future__ import annotations

import hashlib
import re
from dataclasses import dataclass

LONG_WORK_ACK = "已接手，正在后台推进。只有真正需要你决定时才会通知。"
DEFAULT_PROJECT = "spareribes/ai-colleague"
DEFAULT_AUTHORITY = "GitHub Issue #82"
_MAX_OBJECTIVE_CHARS = 640
_MAX_PACKET_CHARS = 2400


@dataclass(frozen=True)
class LongWorkIntent:
    """A classified request whose execution must not occupy the control chat."""

    objective: str


_WORK_REQUEST_PREFIX = r"(?:请(?:你)?(?:帮我)?|帮我|麻烦(?:你)?(?:帮我)?)"
_SENTENCE_START = r"(?:^|[.!?;,:，。！？；])\s*"
_CONTINUATION_ACTION = r"继续(?:推进|处理|做|完成|开发|实现|修复|测试|审查)"
_CONTINUATION_QUESTION_SUFFIX = (
    r"(?!\s*(?:吗|呢|是否|了吗|了没有|了没|有没有|有无|"
    r"(?:的|后)?(?:结果|状态|进度|情况|怎么样|咋样|如何)|到哪|什么))"
)
# A trailing question marker only turns the message into a status query when it genuinely asks about
# a result. Bare 通过/成功/失败 are NOT question markers: they are normally the GOAL of the work
# ("确保测试通过", "让 CI 成功", "处理失败"), so they only count when bound to a question form such as
# "测试通过了吗" / "是否通过" / "通过的情况如何".
_CONTINUATION_QUESTION_TAIL_RE = re.compile(
    r"(?:吗|呢|是否|了吗|了没有|了没|有没有|有无|"
    r"(?:的|后)?(?:结果|状态|进度|情况|怎么样|咋样|如何)|到哪|什么|"
    r"(?:通过|成功|失败)\s*(?:了)?\s*(?:吗|没|没有|么)|"
    r"(?:是否|有没有|有无)\s*(?:能|会)?\s*(?:通过|成功|失败)|"
    r"(?:通过|成功|失败)\s*(?:的|后)?\s*(?:结果|状态|进度|情况|怎么样|咋样|如何)"
    r")\s*[?？!！。]*$"
)
_WORK_REQUEST_PREFIX_RE = re.compile(_WORK_REQUEST_PREFIX)
_LONG_WORK_RE = re.compile(
    rf"(?:"
    rf"{_SENTENCE_START}(?:{_WORK_REQUEST_PREFIX}\s*)?{_CONTINUATION_ACTION}"
    rf"{_CONTINUATION_QUESTION_SUFFIX}\s*\S+"
    rf"|{_WORK_REQUEST_PREFIX}\s*(?:现在|尽快|马上|直接|继续|先)?{_CONTINUATION_ACTION}"
    rf"{_CONTINUATION_QUESTION_SUFFIX}\s*\S+"
    rf"|{_SENTENCE_START}(?:{_WORK_REQUEST_PREFIX}\s*)?把(?:这个|该|本次|以下|这些).{{0,24}}(?:task|任务|功能|问题|改动|pr).{{0,12}}(?:做完|完成|实现|修复|补上)"
    rf"|{_WORK_REQUEST_PREFIX}\s*(?:现在|尽快|马上|直接|先)?把(?:这个|该|本次|以下|这些).{{0,24}}(?:task|任务|功能|问题|改动|pr).{{0,12}}(?:做完|完成|实现|修复|补上)"
    rf"|{_SENTENCE_START}(?:{_WORK_REQUEST_PREFIX}\s*)?(?:执行|运行|跑)(?:一下|下)?(?:这个|该|本次|所有|全部)?(?:实现|测试|审查|review\s*(?:这个|此).{{0,24}}(?:pr|代码)|pr)"
    rf"|{_WORK_REQUEST_PREFIX}\s*(?:现在|尽快|马上|直接|继续|先)?(?:执行|运行|跑)(?:一下|下)?(?:这个|该|本次|所有|全部)?(?:实现|测试|审查|review\s*(?:这个|此).{{0,24}}(?:pr|代码)|pr)"
    rf"|{_WORK_REQUEST_PREFIX}\s*(?:现在|尽快|马上|直接|继续|先)?(?:实现|修复|开发|补上|开始开发)"
    rf"|{_SENTENCE_START}(?:{_WORK_REQUEST_PREFIX}\s*)?(?:实现|修复|开发|补上|开始开发)(?:这个|该|以下|本次|这些).{{0,16}}(?:功能|问题|代码|测试|改动|pr|task|任务)"
    rf"|{_WORK_REQUEST_PREFIX}\s*(?:现在|尽快|马上|直接|先)?(?:测试|运行测试|补上测试)\s*(?:一下|下)?(?:这个|该|本次|以下|这些).{{0,16}}(?:功能|问题|代码|测试|改动|pr|task|任务)?"
    rf"|{_SENTENCE_START}(?:{_WORK_REQUEST_PREFIX}\s*)?(?:测试|运行测试|补上测试)\s*(?:一下|下)?(?:这个|该|本次|以下|这些).{{0,16}}(?:功能|问题|代码|测试|改动|pr|task|任务)?"
    rf"|{_SENTENCE_START}(?:please\s+)?(?:implement|fix|finish|complete|continue|keep going|run tests|open a pr)\b"
    rf"|(?:please|can you|could you|help me)\s+(?:implement|fix|finish|complete|continue|keep going|run tests|open a pr)\b"
    rf"|{_SENTENCE_START}(?:please\s+)?review\s+(?:this|the|my)\s+(?:pr|pull request|code|change|diff)\b"
    rf"|(?:please|can you|could you|help me)\s+review\s+(?:this|the|my)\s+(?:pr|pull request|code|change|diff)\b"
    rf"|{_WORK_REQUEST_PREFIX}\s*(?:review|审查)\s*(?:这个|此|本次|该)?\s*(?:pr|pull request|代码|改动|测试|code|change|diff)"
    rf"|{_SENTENCE_START}(?:review|审查)\s*(?:这个|此|本次|该|this|the|my)?\s*(?:pr|pull request|代码|改动|测试|code|change|diff)"
    rf")",
    re.IGNORECASE,
)
_NEGATED_WORK_RE = re.compile(
    r"(?:不要|别|禁止|无需|不必|不用|do not|don't|never)\s*"
    r"(?:再|去|帮我|你)?\s*"
    r"(?:重跑|派发|新建|创建|启动|执行|运行|继续|实现|修复|开发|测试|审查|review|run tests|execute|create|start|dispatch)",
    re.IGNORECASE,
)
# The first work-language span at or after a given offset — used to test whether work survives a
# leading prohibition, since ``_LONG_WORK_RE.search`` re-matches the clause the negation governs.
_ACTION_VERB_RE = re.compile(
    r"(?:继续(?:推进|处理|做|完成|开发|实现|修复|测试|审查)"
    r"|实现|修复|开发|补上|开始开发|测试|运行测试|补上测试|执行|运行|跑"
    r"|review|审查)"
    r"|(?:please|can you|could you|help me)\s+(?:implement|fix|finish|complete|continue|keep going|run tests|open a pr)\b"
    r"|(?:please\s+)?(?:implement|fix|finish|complete|continue|keep going|run tests|open a pr)\b"
    r"|(?:executed?|ran|finished|completed|implemented|fixed|reviewed)\b",
    re.IGNORECASE,
)


def _work_language_after(text: str, start: int) -> bool:
    """True when the remainder of ``text`` still carries work language."""
    return _ACTION_VERB_RE.search(text, max(start, 0)) is not None


def _clean_text(text: str) -> str:
    return " ".join(str(text or "").replace("\x00", " ").split())


def classify_long_work_request(text: str) -> bool:
    """Return True only for explicit long-work language, not status/attention questions."""
    normalized = _clean_text(text)
    if not normalized or normalized.startswith(("/", "!")):
        return False
    work_match = _LONG_WORK_RE.search(normalized)
    if work_match is None:
        return False
    matched_text = work_match.group(0)
    # A question tail anywhere in the matched span makes it a status question — unless the span
    # also carries an explicit request prefix. The prefix is stripped before the tail test so that
    # ``请继续开发并测试结果如何`` reads as the status question it is.
    tail_scope = _WORK_REQUEST_PREFIX_RE.sub(" ", matched_text, count=1)
    if _CONTINUATION_QUESTION_TAIL_RE.search(tail_scope):
        return False
    # A leading prohibition only suppresses the clause it governs, not the whole message:
    # ``不要执行新任务`` vetoes a bare repeat of the same action, while ``不要执行新任务，继续开发``
    # still asks for work. Reject only when no work language survives after the negation.
    negated = _NEGATED_WORK_RE.search(normalized)
    if negated and negated.start() <= work_match.start() and not _work_language_after(normalized, negated.end()):
        return False
    # A trailing question tail marks a status question even when the message opens with work
    # language: ``不要执行新任务，继续开发 cloud-test 的结果如何`` asks about a result, not for work.
    if _CONTINUATION_QUESTION_TAIL_RE.search(normalized):
        return False
    return True


def build_bounded_execution_packet(
    objective: str,
    *,
    task_id: str,
    project: str = DEFAULT_PROJECT,
    authority: str = DEFAULT_AUTHORITY,
) -> str:
    """Build the worker prompt without importing the giant control transcript."""
    objective = _clean_text(objective)[:_MAX_OBJECTIVE_CHARS]
    project = _clean_text(project)[:200] or DEFAULT_PROJECT
    authority = _clean_text(authority)[:200] or DEFAULT_AUTHORITY
    fixture_scope = bool(re.search(r"(?:fixture|safe local|本地|本地化)", objective, re.IGNORECASE))
    mutation_boundary = (
        "MUTATION: reference-only local fixture; do not commit, push, open a PR, merge, or contact external product repos."
        if fixture_scope
        else "MUTATION: do not touch external product repos or open/merge PRs unless the bounded Objective explicitly authorizes it."
    )
    packet = f"""T4 BOUNDED REMOTE WORK PACKET
PROJECT: {project}
OBJECTIVE: {objective}
TASK: {task_id}
AUTHORITY: {authority}
EXECUTION: Run as a detached worker using the assigned Hermes execution path. Do not run inside the Telegram control session.
CONTEXT: Recover only the named Project, Objective, Task, repository authority, and current durable state. Do not copy or depend on the Telegram transcript.
BOUNDARIES: External product repositories remain READ_ONLY unless the Human explicitly authorizes an exact Project/Task. Do not expose filesystem paths, session IDs, provider names, credentials, tokens, or raw logs.
{mutation_boundary}
RESULT: Return only a concise structured result with STATE (OUTCOME_READY, WAITING_HUMAN, WAITING_CAPACITY, or EXCEPTION), PROJECT, OUTCOME, HUMAN_ACTION, and NEXT_STEP. No raw logs.
"""
    return packet[:_MAX_PACKET_CHARS]


def classify_long_work_intent(text: str) -> LongWorkIntent | None:
    """Return a bounded intent object or None for inline control-chat handling."""
    return LongWorkIntent(_clean_text(text)) if classify_long_work_request(text) else None


def remote_work_idempotency_key(*, platform: str, chat_id: str, message_id: str, objective: str) -> str:
    """Stable, non-secret key so Telegram redelivery cannot create a second task."""
    material = "|".join((str(platform), str(chat_id), str(message_id or objective)))
    return "telegram-remote-work-v2:" + hashlib.sha256(material.encode("utf-8")).hexdigest()


def create_native_remote_task(
    *,
    source,
    packet: str,
    objective: str,
    session_id: str,
    idempotency_key: str,
    delivery_metadata: dict,
) -> str:
    """Create and subscribe one native Kanban task for the originating chat.

    The dispatcher/notifier already provide durable worker execution and terminal delivery; this
    function only supplies their existing task and subscription records.
    """
    from hermes_cli import kanban_db as kb
    from hermes_cli import kanban_db_connect as kbc
    from hermes_cli import kanban_db_notify as kbn
    from hermes_cli import projects_db as pdb
    from hermes_cli.profiles import get_active_profile_name

    assignee = get_active_profile_name() or "default"
    project = None
    with pdb.connect_closing() as project_conn:
        project = pdb.get_project(project_conn, DEFAULT_PROJECT.split("/")[-1])
    project_id = project.id if project is not None else None
    board = project.slug if project is not None else None
    workspace_kind = "worktree" if project_id else "scratch"
    task_title = "Telegram detached: " + _clean_text(objective)[:100]
    conn = kbc.connect(board=board)
    try:
        task_id = kb.create_task(
            conn,
            title=task_title,
            body=packet,
            assignee=assignee,
            created_by=assignee,
            workspace_kind=workspace_kind,
            project_id=project_id,
            idempotency_key=idempotency_key,
            max_runtime_seconds=1800,
            session_id=session_id,
            completion_contract="local-only",
            initial_status="running",
        )
        kbn.add_notify_sub(
            conn,
            task_id=task_id,
            platform=str(getattr(source.platform, "value", source.platform)),
            chat_id=str(source.chat_id),
            thread_id=getattr(source, "thread_id", None),
            user_id=getattr(source, "user_id", None),
            user_id_alt=getattr(source, "user_id_alt", None),
            chat_type=getattr(source, "chat_type", None),
            notifier_profile=getattr(source, "profile", None) or assignee,
            delivery_mode="notify",
            delivery_metadata=delivery_metadata,
        )
    finally:
        conn.close()
    return task_id
