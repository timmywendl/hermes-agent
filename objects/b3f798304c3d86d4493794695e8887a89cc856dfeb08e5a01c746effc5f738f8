# E. event payload <-> task_runs.summary consistency
# --------------------------------------------------------------------------


def test_event_summary_matches_run_summary_fields(tmp_path):
    """The event must carry every *usable* field from the run summary.

    A field whose value the consumer would reject at every budget is dropped
    deliberately (an honest payload), but nothing consumer-valid may be lost —
    and the required outcome/next-step pair must survive.
    """
    from gateway.kanban_watchers_notifier import (
        _COMPLETION_TEXT_FIELDS,
        _safe_completion_value,
    )

    conn = _open(tmp_path)
    task_id = _create_and_complete(conn, summary=REAL_RUN_SUMMARY)

    run = conn.execute(
        "SELECT summary FROM task_runs WHERE task_id = ? ORDER BY id DESC LIMIT 1",
        (task_id,),
    ).fetchone()
    assert run is not None and run["summary"] == REAL_RUN_SUMMARY

    _payload, event_summary = _completed_event_summary(conn, task_id)
    run_fields = {
        line.split("=", 1)[0].strip().upper()
        for line in run["summary"].splitlines()
        if "=" in line
    }
    event_fields = {
        line.split("=", 1)[0].strip().upper()
        for line in (event_summary or "").splitlines()
        if "=" in line
    }
    # Every emitted text value must be acceptable to the consumer.
    for line in (event_summary or "").splitlines():
        if "=" not in line:
            continue
        key, _, value = line.partition("=")
        if key.strip().upper() in _COMPLETION_TEXT_FIELDS and value:
            assert _safe_completion_value(value) is not None, (
                f"event carries a text value the consumer rejects: {key}"
            )
    # This run's SUMMARY value is unusable at every safe budget, so the
    # serializer must withhold the whole partial contract rather than emit an
    # empty required field or a deterministic RESULT_UNAVAILABLE payload.
    assert event_summary is None
    assert not event_fields


def test_swarm_completion_event_preserves_contract(tmp_path):
    """The swarm root path serializes separately — same requirement.

    Reviewer finding on the first revision: the previous version of this test
    called ``complete_task``, so it never exercised ``_activate_root_inline``
    (the swarm root's own event write). This drives that REAL function.

    The summary is deliberately longer than the old ``summary[:400]`` slice so
    the test discriminates: it fails if the swarm path truncates by characters
    instead of preserving field structure.
    """
    from hermes_cli import kanban_swarm as ks

    contract = (
        "SUMMARY=" + ("local tests passed " * 30) + "\nNEXT_STEP=done\n"
        "KANBAN_STATUS=PASS\nPYTEST_STATUS=PASSED\nREVIEW_RESULT=CLEAN"
    )
    conn = _open(tmp_path)
    created = ks.create_swarm(
        conn,
        goal="swarm goal",
        workers=[ks.SwarmWorkerSpec(profile="researcher-a", title="Scan", body="b")],
        verifier_assignee="reviewer",
        synthesizer_assignee="writer",
        created_by="orchestrator",
    )
    # The root is built blocked; the activator flips it to done and writes the
    # completed event through the swarm path.
    conn.execute("UPDATE tasks SET status='blocked' WHERE id=?", (created.root_id,))
    ok = ks._activate_root_inline(conn, created.root_id, summary=contract, metadata={})
    assert ok is True, "swarm root activation did not run"

    row = conn.execute(
        "SELECT payload FROM task_events WHERE task_id=? AND kind='completed'"
        " ORDER BY id DESC LIMIT 1",
        (created.root_id,),
    ).fetchone()
    assert row is not None, "swarm root completion event missing"
    event_summary = json.loads(row["payload"]).get("summary")
    assert event_summary is not None, "swarm path dropped the summary"
    keys = {
        line.split("=", 1)[0].strip().upper()
        for line in event_summary.splitlines()
        if "=" in line
    }
    assert "NEXT_STEP" in keys, "swarm path dropped the required NEXT_STEP field"
    assert "SUMMARY" in keys
    assert _completed_summary_lines(event_summary) != [], (
        "swarm root completion does not project"
    )


