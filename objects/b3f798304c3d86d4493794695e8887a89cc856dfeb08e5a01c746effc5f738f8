def test_structured_serialization_does_not_crash_without_gateway(monkeypatch):
    """The gateway is an OPTIONAL dependency of the producer module.

    Reviewer finding: _rendered_values_acceptable imported the gateway
    unconditionally, so a CLI-only install raised ImportError for any
    structured summary — on the very code path that must never fail.
    """
    import builtins

    from hermes_cli import kanban_db as kb

    real_import = builtins.__import__

    def blocked(name, *args, **kwargs):
        if str(name).startswith("gateway"):
            raise ImportError("gateway unavailable")
        return real_import(name, *args, **kwargs)

    monkeypatch.setattr(builtins, "__import__", blocked)
    out = kb._completion_event_summary("SUMMARY=local tests passed\nNEXT_STEP=done")
    assert out == "SUMMARY=local tests passed\nNEXT_STEP=done"


