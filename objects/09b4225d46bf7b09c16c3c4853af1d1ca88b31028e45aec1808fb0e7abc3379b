def _run_async(test_fn):
    @wraps(test_fn)
    def wrapper(*args, **kwargs):
        return asyncio.run(test_fn(*args, **kwargs))
    return wrapper


def _stub_gateway_sentinel(monkeypatch: pytest.MonkeyPatch) -> None:
    module = types.ModuleType("gateway.run")
    module._AGENT_PENDING_SENTINEL = object()
    monkeypatch.setitem(sys.modules, "gateway.run", module)


