ORIGINAL_STATUS_REQUEST = (
    "老项目 petlibro_cloud_test 上一轮开发现在是什么状态？请自己从 Hermes/Kanban 记录恢复最新任务、代码提交、测试和 Review 结果，"
    "告诉我是否完成、是否还有阻塞。不要执行新任务。"
)


def test_long_work_language_is_detached_but_status_questions_stay_inline():
    assert classify_long_work_request("继续推进 cloud-test，真正需要我决定再找我") is True
    assert classify_long_work_request("把这个 Task 做完，执行实现、测试、review、PR") is True
    assert classify_long_work_request("现在几个项目什么状态？") is False
    assert classify_long_work_request("这个项目当前 executor 是谁？") is False


def test_original_read_only_status_request_never_creates_a_native_task():
    from types import SimpleNamespace
    from unittest.mock import patch
    from gateway.run_inbound import GatewayInboundMixin

    class Adapter:
        def __init__(self):
            self.sent = []

        async def send(self, chat_id, content, metadata=None):
            self.sent.append(content)

    class SessionStore:
        async def get_or_create_session(self, source):
            return SimpleNamespace(session_id="offline-control-session")

    class Runner(GatewayInboundMixin):
        def __init__(self):
            self.adapter = Adapter()
            self.async_session_store = SessionStore()

        async def _hm_admit_event(self, event):
            return event, event.source, False

        def _hm_estop_gate(self, event, source, is_internal):
            return None

        def _delivery_adapter_for(self, source):
            return self.adapter

        def _reply_metadata(self, event):
            return {}

    runner = Runner()
    source = SessionSource(platform=Platform.TELEGRAM, chat_id="offline-chat", chat_type="dm")
    event = MessageEvent(text=ORIGINAL_STATUS_REQUEST, source=source, message_id="offline-status-1")
    created = []

    with patch("gateway.remote_work.create_native_remote_task", side_effect=lambda **kwargs: created.append(kwargs)):
        assert asyncio.run(runner._handle_long_work_request(event, "control")) is False

    assert created == []
    assert runner.adapter.sent == []


