def test_prompt_is_canonical_and_read_only(registry: Path) -> None:
    intent = resolve_control_intent("展开说下 cloud-test", registry_path=registry)
    assert intent is not None
    prompt = build_control_projection_prompt(intent, "展开说下 cloud-test")
    assert "Canonical intent: PROJECT_DETAIL" in prompt
    assert "petlibro-cloud-test-platform" in prompt
    assert "Do not mutate" in prompt
    assert "/Users/" not in prompt


def test_response_sanitization_keeps_detail_but_hides_runtime_identity() -> None:
    raw = """🟢 cloud-test · 正在推进
session ID: agent:main:telegram:dm:123
provider: secret-provider
SHA: abcdef1234567890
PR: #94
worktree: <HOME>/private/cloud-test
"""
    compact = sanitize_control_response(raw, details=False)
    detail = sanitize_control_response(raw, details=True)
    assert "session" not in compact.lower()
    assert "provider" not in compact.lower()
    assert "SHA:" not in compact
    assert "PR:" not in compact
    assert "SHA: abcdef1234567890" in detail
    assert "PR: #94" in detail
    assert "/Users/" not in detail
    assert "[PATH]" in detail
    assert "provider" not in detail.lower()
    raw_sha = "a" * 40
    assert raw_sha not in sanitize_control_response(f"direction {raw_sha}", details=False)


class _Adapter:
    def __init__(self) -> None:
        self.sent: list[str] = []

    async def send(self, chat_id, content, metadata=None):
        self.sent.append(str(content))


class _SemanticHarness(GatewayInboundMixin):
    def __init__(self, registry: Path) -> None:
        self.adapter = _Adapter()
        self.registry = registry
        self.calls = 0
        self.started = asyncio.Event()
        self.release = asyncio.Event()

    def _delivery_adapter_for(self, source):
        return self.adapter

    def _thread_metadata_for_source(self, source, anchor=None):
        return {"reply_to": anchor}

    def _reply_anchor_for_event(self, event):
        return str(event.message_id or "")

    def _semantic_control_intent_for_event(self, event):
        # Keep the production Telegram gate while making the test registry explicit.
        if event.source.platform != Platform.TELEGRAM:
            return None
        from gateway.semantic_control import resolve_control_intent
        return resolve_control_intent(event.text, registry_path=self.registry)

    async def _run_readonly_control_projection(self, prompt, source, task_id, event_message_id=None):
        self.calls += 1
        self.started.set()
        await self.release.wait()
        return "总体：3 个项目正常推进。\nsession: hidden\nworktree: /private/worktree/cloud-test"


def _event(text: str, message_id: str) -> MessageEvent:
    source = SessionSource(
        platform=Platform.TELEGRAM,
        chat_id="chat-1",
        chat_type="dm",
        user_id="user-1",
    )
    return MessageEvent(text=text, source=source, message_id=message_id)


@_run_async
async def test_duplicate_inflight_queries_coalesce_and_later_query_is_fresh(registry: Path) -> None:
    runner = _SemanticHarness(registry)
    first = asyncio.create_task(runner._route_semantic_control_query(_event("几个项目怎么样了", "m1"), "session-1"))
    await runner.started.wait()
    second = asyncio.create_task(runner._route_semantic_control_query(_event("现在几个项目什么状态？", "m2"), "session-1"))
    await asyncio.sleep(0)
    assert runner.calls == 1
    runner.release.set()
    assert await first is True
    assert await second is True
    assert runner.calls == 1
    assert len(runner.adapter.sent) == 1

    runner.started = asyncio.Event()
    runner.release = asyncio.Event()
    fresh = asyncio.create_task(runner._route_semantic_control_query(_event("项目都咋样", "m3"), "session-1"))
    await runner.started.wait()
    runner.release.set()
    assert await fresh is True
    assert runner.calls == 2
    assert len(runner.adapter.sent) == 2


@_run_async
async def test_semantic_projection_timeout_is_bounded(registry: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    runner = _SemanticHarness(registry)

    async def slow_projection(*args, **kwargs):
        await asyncio.sleep(1)
        return "never delivered"

    runner._run_readonly_control_projection = slow_projection
    monkeypatch.setattr("gateway.run_inbound._SEMANTIC_CONTROL_TIMEOUT_SECONDS", 0.01)
    result = await runner._route_semantic_control_query(_event("项目都咋样", "timeout-1"), "session-1")
    assert result is True
    assert runner.adapter.sent == ["当前无法读取最新项目状态，请稍后再试。"]


