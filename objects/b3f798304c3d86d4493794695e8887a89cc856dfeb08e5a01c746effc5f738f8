"""Issue #92: completed-event serialization must preserve the completion contract.

Root cause (real Telegram task t_220017aa, run 17):

``task_runs.summary`` held a correct 7-line ``KEY=value`` completion contract, but
``_completed_event_payload`` stored it through ``_first_line(event_summary, 400)``.
That is a *first-line-only* projection, so the event payload kept only ``SUMMARY=``
and dropped ``NEXT_STEP``. The notifier requires BOTH an outcome field and a
next-step field, so projection returned ``[]`` and Telegram showed
``RESULT_UNAVAILABLE`` even though the agent (which reads ``task_runs.summary``
directly) could render the full result.

These tests pin the event-serialization contract: line structure survives, the
required fields survive, the payload stays bounded, and the result still projects
through the REAL notifier projector.
"""

from __future__ import annotations

import json
import sqlite3

import pytest

from hermes_cli import kanban_db as kb
from gateway.kanban_watchers_notifier import _completed_summary_lines

# The verbatim run-17 summary that failed in production (t_220017aa run 17).
REAL_RUN_SUMMARY = (
    "SUMMARY=Read-only offline verification passed in the exact worktree; "
    "required starting head held unchanged, worktree stayed clean, "
    "documentation and the single safety regression test both present and the "
    "targeted test run passed with zero network or device activity.\n"
    "NEXT_STEP=done\n"
    "KANBAN_STATUS=PASS\n"
    "PYTEST_STATUS=PASSED\n"
    "REVIEW_RESULT=CLEAN\n"
    "COMMIT=5cb85df\n"
    "BLOCKERS=none"
)

# A summary that DOES satisfy the consumer allowlist end to end.
PROJECTABLE_SUMMARY = (
    "SUMMARY=local tests passed\n"
    "NEXT_STEP=done\n"
    "KANBAN_STATUS=PASS\n"
    "PYTEST_STATUS=PASSED\n"
    "REVIEW_RESULT=CLEAN"
)


def _open(tmp_path):
    return kb.connect(tmp_path / "board.db")


def _create_and_complete(conn, *, summary: str, result=None):
    task_id = kb.create_task(conn, title="contract", body="b", created_by="tester")
    assert kb.claim_task(conn, task_id, claimer="tester") is not None
    run_row = conn.execute(
        "SELECT current_run_id FROM tasks WHERE id=?", (task_id,)
    ).fetchone()
    run_id = run_row["current_run_id"]
    assert run_id is not None, "run was not created by claim_task"
    ok = kb.complete_task(
        conn, task_id, summary=summary, result=result, expected_run_id=run_id,
    )
    assert ok is True
    return task_id


def _completed_event_summary(conn, task_id):
    row = conn.execute(
        "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'completed'"
        " ORDER BY id DESC LIMIT 1",
        (task_id,),
    ).fetchone()
    assert row is not None, "no completed event was written"
    payload = json.loads(row["payload"])
    return payload, payload.get("summary")


