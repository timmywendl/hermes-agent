# ---------------------------------------------------------------------------
# 5. Fail-closed inputs
# ---------------------------------------------------------------------------


@pytest.mark.parametrize(
    "bad",
    [
        "review_verdict",                      # not a mapping
        {},                                    # no kind
        {"kind": ""},                          # blank kind
        {"kind": 42},                          # non-string kind
        {"kind": "custom_verdict"},            # no wired wake site
        {"kind": "commented", "ref": 7},       # non-string ref
        {"kind": "commented", "await_from": "mc"},   # not a list
        {"kind": "commented", "await_from": [""]},   # blank author
    ],
)
def test_malformed_bound_decision_is_refused(kanban_home: Path, bad) -> None:
    """A malformed binding must fail the block loudly rather than record a
    wait that can never be satisfied (or, worse, one satisfied by anything)."""
    with kbc.connect() as conn:
        tid = kb.create_task(conn, title="bad binding")
        kclaim = kb.claim_task(conn, tid)
        ok, reason = kb.block_task(
            conn, tid, reason="wait", expected_run_id=kclaim.current_run_id,
            bound_decision=bad, with_reason=True,
