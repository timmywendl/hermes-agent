def test_review_dispatch_gate_and_caps_unchanged(home, monkeypatch):
    """The ``review_dispatch`` config gate still decides whether the review lane
    is dispatched at all (Gate E: caps/reservation/gate untouched)."""
    # The dispatcher refuses to spawn an assignee that is not an installed profile.
    for name in ("builder", "reviewer"):
        profile = home / "profiles" / name
        profile.mkdir(parents=True, exist_ok=True)
        (profile / "config.yaml").write_text("{}\n")
    with kbc.connect() as conn:
        tid = _new_review(conn, title="gated review")
        spawned: list[str] = []

        def spawn(task, workspace, board=None):
            spawned.append(task.id)
            return 42

        monkeypatch.setattr(kbd, "review_dispatch_enabled", lambda: False)
        kbd.dispatch_once(conn, spawn_fn=spawn)
        assert tid not in spawned, "review_dispatch=False must not spawn reviewers"

        monkeypatch.setattr(kbd, "review_dispatch_enabled", lambda: True)
        kbd.dispatch_once(conn, spawn_fn=spawn)
        assert tid in spawned, "review_dispatch=True must still spawn the reviewer"
        assert kb.get_task(conn, tid).review_lane_pending is True


# ---------------------------------------------------------------------------
# Gate 5: the new diagnostic fires for the parked card only
# ---------------------------------------------------------------------------


def test_review_no_verdict_diagnostic_fires_for_parked_card_only(home, monkeypatch):
    """The parked card surfaces as Human attention (task id, branch, HEAD, last
    failure class); a healthy review card raises nothing. No second diagnostics
    surface — the rule lives in the existing engine."""
    monkeypatch.setattr(kb, "_pid_alive", lambda _pid: False)
    with kbc.connect() as conn:
        # Healthy: a review card simply waiting for a reviewer.
        healthy_review = _new_review(conn, title="healthy review")
        # Parked: drive the real breaker to exhaustion on a review card.
        parked = _new_review(conn, title="parked review")
        conn.execute("UPDATE tasks SET max_retries = 1 WHERE id = ?", (parked,))
        conn.commit()
        _reviewer_death(conn, parked, exit_code=0)
        assert kb.get_task(conn, parked).status == "blocked"

        def kinds(tid):
            task = kb.get_task(conn, tid)
            return {d.kind: d for d in kd.compute_task_diagnostics(
                task, kb.list_events(conn, tid), kb.list_runs(conn, tid),
            )}

        parked_kinds = kinds(parked)
        assert "review_no_verdict" in parked_kinds
        diag = parked_kinds["review_no_verdict"]
        assert diag.severity == "error"
        assert parked in diag.detail or parked in diag.title
        assert diag.data["task_id"] == parked
        assert diag.data["failure_class"]
        assert "branch" in diag.data and "head" in diag.data
        assert diag.actions, "an operator-fixable signal needs a recovery action"

        assert "review_no_verdict" not in kinds(healthy_review), (
            "a healthy review card must not raise the parked-review diagnostic"
        )


def test_review_no_verdict_diagnostic_ignores_a_done_review(home):
    with kbc.connect() as conn:
        tid = _new_review(conn)
        claimed = kb.claim_review_task(conn, tid)
        assert kb.complete_task(
            conn, tid, summary="ok", metadata={"review_outcome": "approved"},
            expected_run_id=claimed.current_run_id,
        )
        task = kb.get_task(conn, tid)
        kinds = {d.kind for d in kd.compute_task_diagnostics(
            task, kb.list_events(conn, tid), kb.list_runs(conn, tid),
        )}
        assert "review_no_verdict" not in kinds


# ---------------------------------------------------------------------------
# Gate 6 (implementation): the column migrates onto an older board
# ---------------------------------------------------------------------------


def test_init_db_upgrades_a_board_predating_review_lane_pending(home):
    import sqlite3

    path = kb.kanban_db_path()
    # Simulate a board written before the column existed.
    raw = sqlite3.connect(path)
    raw.executescript(kb.SCHEMA_SQL)
    raw.execute("ALTER TABLE tasks DROP COLUMN review_lane_pending")
    raw.execute(
        "INSERT INTO tasks (id, title, status, created_at) VALUES ('t_legacy', 'old', 'review', 1)"
    )
    raw.commit()
    columns = {r[1] for r in raw.execute("PRAGMA table_info(tasks)")}
    assert "review_lane_pending" not in columns, "fixture must start pre-column"
    raw.close()

    kb.init_db()  # <- the upgrade path

    raw = sqlite3.connect(path)
    columns = {r[1] for r in raw.execute("PRAGMA table_info(tasks)")}
    assert "review_lane_pending" in columns, "init_db must add the missing column"
    defaulted = raw.execute(
        "SELECT review_lane_pending FROM tasks WHERE id = 't_legacy'"
    ).fetchone()[0]
    assert defaulted == 0, "pre-existing rows must read as 'owed no verdict'"
    raw.close()
