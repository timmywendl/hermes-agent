def test_base_adapter_routes_long_work_before_active_session_guard():
    class StubAdapter(BasePlatformAdapter):
        async def connect(self):
            return None

        async def disconnect(self):
            return None

        async def send(self, chat_id, content, **kwargs):
            return None

        async def get_chat_info(self, chat_id):
            return None

    async def run_case():
        adapter = object.__new__(StubAdapter)
        calls = []
        adapter._message_handler = object()
        adapter._no_message_handler_logged = False
        adapter._long_work_handler = lambda event, key: asyncio.sleep(0, result=True)
        adapter._drop_unresolved = lambda event: False
        adapter._event_session_key = lambda event: "agent:main:telegram:dm:chat"
        adapter._active_sessions = {"agent:main:telegram:dm:chat": object()}
        adapter._heal_stale_session_lock = lambda key: calls.append(("heal", key))
        adapter._handle_message_while_active = lambda event, key: calls.append(("busy", key))
        source = SessionSource(platform=Platform.TELEGRAM, chat_id="chat", chat_type="dm")
        event = MessageEvent(text="继续推进 ai-colleague fixture", source=source, message_id="m1")

        await BasePlatformAdapter.handle_message(adapter, event)
        assert event._gateway_accepted is True
        assert calls == []

    asyncio.run(run_case())


def test_long_work_handler_creates_one_native_task_and_acks_without_relay():
    from gateway.run_inbound import GatewayInboundMixin
    from unittest.mock import patch

    class Adapter:
        def __init__(self):
            self.sent = []

        async def send(self, chat_id, content, metadata=None):
            self.sent.append((chat_id, content, metadata))

    class SessionEntry:
        session_id = "control-session"

    class SessionStore:
        async def get_or_create_session(self, source):
            return SessionEntry()

    class Runner:
        def __init__(self):
            self.adapter = Adapter()
            self.async_session_store = SessionStore()
            self.created = []

        async def _hm_admit_event(self, event):
            return event, event.source, False

        def _hm_estop_gate(self, event, source, is_internal):
            return None

        def _delivery_adapter_for(self, source):
            return self.adapter

        def _reply_metadata(self, event):
            return {"telegram_reply_to_message_id": event.message_id, "_interim_send": True}

    async def run_case():
        runner = Runner()
        source = SessionSource(platform=Platform.TELEGRAM, chat_id="chat", chat_type="dm")
        event = MessageEvent(
            text="继续推进 ai-colleague fixture，真正需要我决定再找我",
            source=source,
            message_id="m1",
        )

        def create_task(**kwargs):
            runner.created.append(kwargs)
            return "t_remote_1", True

        with patch("gateway.remote_work.create_native_remote_task", side_effect=create_task):
            assert await GatewayInboundMixin._handle_long_work_request(runner, event, "control") is True
            assert await GatewayInboundMixin._handle_long_work_request(runner, event, "control") is True

        assert len(runner.created) == 2
        assert runner.created[0]["session_id"] == "control-session"
        assert "Do not copy or depend on the Telegram transcript" in runner.created[0]["packet"]
        assert runner.adapter.sent[0][1] == LONG_WORK_ACK
        assert runner.adapter.sent[0][2]["_interim_send"] is True
        assert runner.created[0]["idempotency_key"] == runner.created[1]["idempotency_key"]

    asyncio.run(run_case())


def test_create_native_remote_task_persists_origin_subscription(tmp_path, monkeypatch):
    from gateway.remote_work import create_native_remote_task
    from hermes_cli import kanban_db_notify as kbn
    from hermes_cli import kanban_db_connect as kbc

    home = tmp_path / ".hermes"
    home.mkdir()
    monkeypatch.setenv("HERMES_HOME", str(home))
    monkeypatch.setenv("HERMES_KANBAN_DB", str(home / "kanban.db"))
    monkeypatch.setattr(Path, "home", lambda: tmp_path)
    from hermes_cli import kanban_db as kb
    from hermes_cli import kanban_db_connect as kbc
    kb.init_db()
    kbc.init_db()

    source = SessionSource(
        platform=Platform.TELEGRAM,
        chat_id="chat-42",
        chat_type="dm",
        thread_id="topic-7",
        user_id="user-9",
    )
    task_id, subscribed = create_native_remote_task(
        source=source,
        packet="bounded packet",
        objective="continue fixture",
        session_id="control-session",
        idempotency_key="telegram-remote-work-v2:test",
        delivery_metadata={"thread_id": "topic-7", "chat_type": "dm"},
    )

    assert subscribed is True
    with kbc.connect() as conn:
        rows = kbn.list_notify_subs(conn, task_id)
    assert len(rows) == 1
    assert rows[0]["platform"] == "telegram"
    assert rows[0]["chat_id"] == "chat-42"
    assert rows[0]["thread_id"] == "topic-7"
    assert rows[0]["user_id"] == "user-9"


